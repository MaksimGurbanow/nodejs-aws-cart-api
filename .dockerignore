# DEV tools, linters
.prettierrc
.eslintrc.js
.vscode
.elasticbeanstalk

# Env variables
.env.example

# Log files
*.log
npm-debug.log
yarn-error.log
pnpm-lock.yaml

# even though these files are used to configure docker, they are not needed in container
Dockerfile
.dockerignore

# git is not required in containers
.git
.gitignore

# generated by npm
package-lock.json

# Docs are not needed in image
README.md

# Scripts are not needed in image
scripts
get-token.sh

# Build folder, it will be generated in container
dist

# the image doesn't need test folder as it doesn't provide functionaly for the app
test

# not required as we'll install packets while builading an image
node_modules

*.swp

# exclude all documentary files
**/*.d.ts
**/*.spec.ts
**/*.test.ts

dalle/
